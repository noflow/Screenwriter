# Normalise everything to LF in the repository. Git still checks out CRLF on
# Windows if core.autocrlf is set, but what's stored stays consistent — which is
# what stops the "this file uses LF" warning and the whole-file diffs that follow it.
* text=auto eol=lf

# Sources
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.py      text eol=lf

# Godot
*.gd      text eol=lf
*.tres    text eol=lf
*.tscn    text eol=lf
*.godot   text eol=lf

# Game data — these are read by the tool and by Godot, so keep them byte-stable
*.character text eol=lf

# Never touch these
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.ogg     binary
*.wav     binary
*.mp3     binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.zip     binary
*.import  binary
